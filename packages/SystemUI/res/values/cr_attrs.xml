<resources>

    <!-- Smartspace -->
    <attr name="backgroundCornerRadius" format="dimension" />
    <attr name="smartspaceSubtitleTextSize" format="dimension" />
    <attr name="smartspaceTitleTextSize" format="dimension" />
    <declare-styleable name="WeatherSmartspaceView">
        <attr name="iconInset" format="dimension" />
        <attr name="iconSize" format="dimension" />
        <attr name="removeTextDescent" format="boolean" />
        <attr name="textDescentExtraPadding" format="dimension" />
    </declare-styleable>

    <declare-styleable name="WeatherTextView">
        <attr name="weatherText" format="string" />
    </declare-styleable>
</resources>
