<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ambient_indication"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:forceHasOverlappingRendering="false">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ambient_indication_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/ambient_indication_wrapper_container"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="16dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ambient_indication_container_background"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:importantForAccessibility="no"/>
            <FrameLayout
                android:gravity="center"
                android:id="@+id/ambient_indication_extended_container"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ambient_indication_collapsed_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ambient_indication_icon"
                        android:background="@android:color/transparent"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:importantForAccessibility="no"/>
                    <FrameLayout
                        android:gravity="start|center_vertical"
                        android:id="@+id/ambient_indication_text_container"
                        android:clipChildren="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="2dp"
                        android:paddingEnd="14dp">
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:id="@+id/text_set_real"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textAppearance="@style/TextAppearance.Keyguard.BottomArea"
                                android:textSize="14sp"
                                android:id="@+id/ambient_indication_text"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:shadowColor="@android:color/transparent"
                                android:forceHasOverlappingRendering="false"/>
                            <TextView
                                android:textAppearance="@style/TextAppearance.Keyguard.BottomArea"
                                android:textSize="14sp"
                                android:id="@+id/ambient_indication_text_extended"
                                android:visibility="gone"
                                android:clickable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:shadowColor="@android:color/transparent"
                                android:importantForAccessibility="no"
                                android:forceHasOverlappingRendering="false"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/text_set_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0">
                            <TextView
                                android:textAppearance="@style/TextAppearance.Keyguard.BottomArea"
                                android:textSize="14sp"
                                android:id="@+id/ambient_indication_text_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:shadowColor="@android:color/transparent"
                                android:importantForAccessibility="no"
                                android:forceHasOverlappingRendering="false"/>
                            <TextView
                                android:textAppearance="@style/TextAppearance.Keyguard.BottomArea"
                                android:textSize="14sp"
                                android:id="@+id/ambient_indication_text_extended_temp"
                                android:clickable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:shadowColor="@android:color/transparent"
                                android:importantForAccessibility="no"
                                android:forceHasOverlappingRendering="false"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ambient_indication_action_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/ambient_indication_like_container"
                        android:background="@drawable/rounded_rectangle_20dp"
                        android:padding="12dp"
                        android:clickable="true"
                        android:layout_width="48dp"
                        android:layout_height="48dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/ambient_indication_like_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:scaleType="fitCenter"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/ambient_indication_play_container"
                        android:background="@drawable/rounded_rectangle_20dp"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/ambient_indication_play_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/accessibility_now_playing_play_icon"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/docked_top_icon"
        android:padding="@dimen/dock_top_logo_padding"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/dock_logo_min_size"
        android:layout_height="@dimen/dock_logo_min_size"
        android:scaleType="fitXY"
        android:cropToPadding="true"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/gemini_space_wrapper_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:gravity="center"
            android:id="@+id/gemini_space_extended_container"
            android:background="@drawable/bg_smartspace_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginHorizontal="48dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/gemini_space_text_container"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="2dp"
                android:paddingEnd="14dp">
                <TextView
                    android:textAppearance="@style/TextAppearance.Keyguard.BottomArea"
                    android:textSize="18sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/gemini_space_text"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:forceHasOverlappingRendering="false"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Keyguard.BottomArea"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/gemini_space_text_extended"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:forceHasOverlappingRendering="false"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Keyguard.BottomArea"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/gemini_space_action_button"
                    android:background="@drawable/bg_smartspace_action_button"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:forceHasOverlappingRendering="false"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
