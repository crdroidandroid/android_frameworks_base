<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pager_dots_with_arrows_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/pager_dots_with_arrows_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal">

    <com.google.android.systemui.smartspace.PaginationArrow
        android:id="@+id/left_pagination_arrow"
        android:layout_width="@dimen/pagination_arrow_touch_size"
        android:layout_height="@dimen/pagination_arrow_touch_size"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/pagination_arrow_margin_outer"
        android:layout_marginEnd="@dimen/pagination_arrow_margin_inner"
        android:background="@drawable/pagination_arrow_background"
        android:contentDescription="@string/accessibility_smartspace_previous_page"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_start_smartspace"
        android:visibility="gone" />

    <com.google.android.systemui.smartspace.PagerDots
        android:id="@+id/pager_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical" />

    <com.google.android.systemui.smartspace.PaginationArrow
        android:id="@+id/right_pagination_arrow"
        android:layout_width="@dimen/pagination_arrow_touch_size"
        android:layout_height="@dimen/pagination_arrow_touch_size"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/pagination_arrow_margin_inner"
        android:layout_marginEnd="@dimen/pagination_arrow_margin_outer"
        android:background="@drawable/pagination_arrow_background"
        android:contentDescription="@string/accessibility_smartspace_next_page"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_end_smartspace"
        android:visibility="gone" />
</LinearLayout>
