<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/date_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/Bebas"
        android:singleLine="true"
        android:textAllCaps="true"
        android:gravity="center"
        android:textAlignment="center"
        android:format12Hour="EEEE, MMMM d"
        android:format24Hour="EEEE, MMMM d"/>

    <TextClock
        android:id="@+id/hour_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-15dp"
        android:textSize="200dp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/Bebas"
        android:layout_gravity="center"
        android:format12Hour="hh"
        android:format24Hour="HH"/>

    <TextClock
        android:id="@+id/minute_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-15dp"
        android:textSize="200dp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/Gobold"
        android:layout_gravity="center"
        android:format12Hour="mm"
        android:format24Hour="mm"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginTop="-15dp">

        <com.android.systemui.weather.WeatherImageView
            android:id="@+id/weather_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <com.android.systemui.weather.WeatherTextView
            android:id="@+id/weather_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/Bebas"
            android:textColor="@android:color/white"
            android:textSize="18dp"
            android:textAllCaps="true"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>

