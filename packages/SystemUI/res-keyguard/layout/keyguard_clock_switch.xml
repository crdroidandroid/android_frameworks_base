<!-- Dummy view maintaining IDs for ROM compatibility -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyguard_clock_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:visibility="gone">
    
    <!-- Dummy clock views -->
    <View
        android:id="@+id/lockscreen_clock_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
        
    <View
        android:id="@+id/lockscreen_clock_view_large"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Dummy status area -->
    <LinearLayout
        android:id="@+id/keyguard_status_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Dummy includes - replace with empty views -->
        <View
            android:id="@+id/keyguard_slice_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/keyguard_weather_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/aod_ls"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/clock_ls"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/keyguard_info_widgets"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/keyguard_widgets"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Dummy notification container -->
        <View
            android:id="@+id/left_aligned_notification_icon_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
            
    </LinearLayout>
</FrameLayout>
