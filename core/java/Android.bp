    name: "dropboxmanager_aidl",
    srcs: [":dropboxmanager_aidl_sources"],
    unstable: true,
    backend: {
        java: {
            additional_libs: ["unsupportedappusage"],
            enabled: true,
        },
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "com.android.virt",
            ],
        },
    },
}

