java_system_features_srcs {
    name: "systemfeatures-gen-srcs",
    full_class_name: "com.android.internal.pm.RoSystemFeatures",
    visibility: ["//visibility:private"],
}

// Set of proguard flags that may be implicitly applied to bundled targets built
// against private SDK APIs. We don't inject these into framework targets
// directly as we don't want them propagating across any library boundaries.
filegroup {
    name: "framework-private-proguard",
    srcs: [":systemfeatures-gen-srcs{.proguardFlagsFiles}"],
    visibility: ["//visibility:private"],
}

