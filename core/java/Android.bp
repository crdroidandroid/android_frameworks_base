                srcs: ["android/service/uprobestats/UprobestatsFrameworkInitializer.java.mock"],
                cmd: "mkdir -p android/service/uprobestats/; cp $(in) $(out);",
                out: ["android/service/uprobestats/UprobestatsFrameworkInitializer.java"],
